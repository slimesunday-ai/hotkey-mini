      },
      {
        "group": "feelgood",
        "likes": "parties, gifts, kept promises, battles"
      }
    ],
    "jobs": [
      {
        "job": "smuggler",
        "does": "runs 4 chems or 2 parts in from the docks",
        "buys": "nothing",
        "sells": "chems to chemists, parts to gunrunners"
      },
      {
        "job": "chemist",
        "does": "cooks 2 chems into 3 product at home",
        "buys": "chems from smugglers",
        "sells": "product to dealers"
      },
      {
        "job": "dealer",
        "does": "sells up to 3 product to customers on the corner, bar or park",
        "buys": "product from chemists",
        "sells": "product to customers"
      },
      {
        "job": "gunrunner",
        "does": "builds 2 parts into 1 gun at home",
        "buys": "parts from smugglers",
        "sells": "guns"
      }
    ],
